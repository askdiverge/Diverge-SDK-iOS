    "delete.confirmation" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg forstår, at mine data slettes permanent"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich verstehe, dass meine Daten dauerhaft gelöscht werden"
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich verstehe, dass meine Daten dauerhaft gelöscht werden"
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich verstehe, dass meine Daten dauerhaft gelöscht werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I understand that my data will be permanently deleted"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mõistan, et minu andmed kustutatakse jäädavalt"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrän, että tietoni poistetaan pysyvästi"
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg forstår, at mine data slettes permanent"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je comprends que mes données seront définitivement supprimées"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ég skil að gögnum mínum verður eytt varanlega"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprantu, kad mano duomenys bus visam laikui ištrinti"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es saprotu, ka mani dati tiks neatgriezeniski dzēsti"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg forstår at dataene mine slettes permanent"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik begrijp dat mijn gegevens definitief worden verwijderd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozumiem, że moje dane zostaną trwale usunięte"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag förstår att mina data raderas permanent"
          }
        }
      }
    },
    "delete.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent mine chats og tilhørende data. Handlingen kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden meine Chats und die zugehörigen Daten dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden meine Chats und die zugehörigen Daten dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden meine Chats und die zugehörigen Daten dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete my chats and corresponding data. This action can not be undone."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See kustutab jäädavalt minu vestlused ja nendega seotud andmed. Seda toimingut ei saa tagasi võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa pysyvästi keskusteluni ja niihin liittyvät tiedot. Toimintoa ei voi perua."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent mine chats og tilhørende data. Handlingen kan ikke fortrydes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprimera définitivement mes discussions et les données associées. Elle est irréversible."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta eyðir varanlega spjallinu mínu og tilheyrandi gögnum. Ekki er hægt að taka þessa aðgerð til baka."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taip visam laikui bus ištrinti mano pokalbiai ir su jais susiję duomenys. Šio veiksmo atšaukti negalima."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī darbība neatgriezeniski dzēsīs manas tērzēšanas sarunas un ar tām saistītos datus. Šo darbību nevar atsaukt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent chattene mine og tilhørende data. Handlingen kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden mijn chats en bijbehorende gegevens definitief verwijderd. Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to trwałe usunięcie moich czatów i powiązanych danych. Tej operacji nie można cofnąć."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta raderar permanent mina chattar och tillhörande data. Åtgärden kan inte ångras."
          }
        }
      }
    },
