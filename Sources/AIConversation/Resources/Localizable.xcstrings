    "delete.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent mine chats og tilhørende data. Handlingen kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden meine Chats und die zugehörigen Daten dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden meine Chats und die zugehörigen Daten dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden meine Chats und die zugehörigen Daten dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete my chats and corresponding data. This action can not be undone."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See kustutab jäädavalt minu vestlused ja nendega seotud andmed. Seda toimingut ei saa tagasi võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa pysyvästi keskusteluni ja niihin liittyvät tiedot. Toimintoa ei voi perua."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent mine chats og tilhørende data. Handlingen kan ikke fortrydes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprimera définitivement mes discussions et les données associées. Elle est irréversible."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta eyðir varanlega spjallinu mínu og tilheyrandi gögnum. Ekki er hægt að taka þessa aðgerð til baka."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taip visam laikui bus ištrinti mano pokalbiai ir su jais susiję duomenys. Šio veiksmo atšaukti negalima."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī darbība neatgriezeniski dzēsīs manas tērzēšanas sarunas un ar tām saistītos datus. Šo darbību nevar atsaukt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
