    "delete.validation" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt kryds i feltet for at bekræfte, at du vil slette dine data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte bestätigen Sie durch Aktivieren des Kästchens, dass Sie Ihre Daten löschen möchten."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte bestätigen Sie durch Aktivieren des Kästchens, dass Sie Ihre Daten löschen möchten."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte bestätigen Sie durch Aktivieren des Kästchens, dass Sie Ihre Daten löschen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please check the box to confirm that you want to delete your data."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Märgi ruut, et kinnitada oma andmete kustutamine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvista valintaruudulla, että haluat poistaa tietosi."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt kryds i feltet for at bekræfte, at du vil slette dine data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez cocher la case pour confirmer que vous souhaitez supprimer vos données."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakaðu í reitinn til að staðfesta að þú viljir eyða gögnunum þínum."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pažymėkite langelį, kad patvirtintumėte, jog norite ištrinti savo duomenis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lūdzu, atzīmējiet izvēles rūtiņu, lai apstiprinātu, ka vēlaties dzēst savus datus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kryss av i boksen for å bekrefte at du vil slette dataene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vink het vakje aan om te bevestigen dat je je gegevens wilt verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznacz pole, aby potwierdzić, że chcesz usunąć swoje dane."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kryssa i rutan för att bekräfta att du vill radera dina data."
          }
        }
      }
    },
    "error.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke indlæse chatassistenten. Kontroller din forbindelse og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Chat-Assistent konnte nicht geladen werden. Bitte prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Chat-Assistent konnte nicht geladen werden. Bitte prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
