<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- The SDK talks only to its own assistant backend (DI) to
	     provide the chat service, not to link data with third parties for advertising.
	     TODO(vendor): confirm the endpoint host does not qualify as a tracking domain; if it
	     does, add it here. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- The module uses no Apple "required reason" APIs (no UserDefaults, file-timestamp,
	     disk-space, system-boot-time, or active-keyboard access). It caches the remote font asset
	     under Caches, keyed by content hash; image caching is the host's, via the injected loader. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The user's typed messages, the optional page-context string, and close-rating
		     free-text feedback are transmitted to the assistant backend. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Photos the visitor attaches in the composer are transmitted to the assistant
		     backend as part of the chat message. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
