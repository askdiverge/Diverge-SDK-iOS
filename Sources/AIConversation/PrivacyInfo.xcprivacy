<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- The SDK talks only to the Diverge chat API (`api.dialogintelligens.dk`, or the host's
	     override) to provide the chat service. That host is first-party to the service, receives
	     no advertising identifiers, and is not used to link data across apps or companies, so it
	     is not a tracking domain under App Store rules and the list is deliberately empty. If the
	     SDK ever contacts an analytics or advertising host, add it here and flip
	     NSPrivacyTracking to true. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- The module uses no Apple "required reason" APIs (no UserDefaults, file-timestamp,
	     disk-space, system-boot-time, or active-keyboard access). It caches the remote font asset
	     under Caches, keyed by content hash; image caching is the host's, via the injected loader. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The user's typed messages and the optional page-context string are transmitted to
		     the assistant backend. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Photos the visitor attaches in the composer are transmitted to the assistant
		     backend as part of the chat message. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
